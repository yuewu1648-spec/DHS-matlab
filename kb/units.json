{
  "id": "units",
  "type": "units",
  "name": "单位表（Units registry）",
  "name_en": "BioModel-MATLAB units registry",
  "schema_version": "bma.kb.units.v2",
  "description": "bma.modelSpec.v1 中 unit 字段的权威词表。spec.validate 应按单位 id 在此表中查找；找不到时报 BMA_UNIT_UNKNOWN 并提示本表可用单位。factor 统一换算到 base（基准单位），供量纲一致性检查：dim 相同即可相加/比较；rate = 某维度 / 时间。",
  "units_format": "array of objects with ASCII keys {id, dim, factor, base, symbol, aliases, note}; lookup by id = units[i].id. MATLAB jsondecode cannot preserve non-identifier object keys ('1' -> 'x1', '1/s' -> 'x1_s'), so the array form is required for spec.validate.",
  "dimensions": {
    "dimensionless": "无量纲（比例、Hill 系数、R0、控制系数等）",
    "count": "个体/细胞计数（person、individual、cell、cfu），彼此可换算，基准 1 个个体",
    "concentration": "物质的量浓度，基准 M = mol/L",
    "amount": "物质的量，基准 mol",
    "mass": "质量，基准 g",
    "mass_concentration": "质量浓度，基准 g/L（= mg/mL）",
    "volume": "体积，基准 L",
    "time": "时间，基准 s",
    "frequency": "一阶速率常数 / 时间倒数，基准 1/s",
    "rate_per_concentration": "双分子速率常数 / (浓度·时间)，基准 1/(M*s)",
    "concentration_rate": "浓度变化速率（反应通量），基准 M/s",
    "count_rate": "计数变化速率，基准 count/s",
    "length": "长度，基准 m",
    "area": "面积，基准 m^2",
    "diffusion_coefficient": "扩散系数，基准 m^2/s",
    "voltage": "电位，基准 V",
    "current_density": "电流密度（膜电流），基准 A/m^2",
    "conductance_per_area": "电导密度（膜电导），基准 S/m^2",
    "capacitance_per_area": "电容密度（膜电容），基准 F/m^2",
    "voltage_rate": "电位变化速率（dV/dt），基准 V/s",
    "energy": "能量，基准 J = kg·m²/s²",
    "molar_energy": "摩尔能量，基准 J/mol（ΔG/ΔH 常用）",
    "power": "功率，基准 W = J/s",
    "specific_power": "比功率，基准 W/kg",
    "pressure": "压强，基准 Pa = N/m²",
    "molality": "质量摩尔浓度，基准 mol/kg（注意与 M=mol/L 不同）"
  },
