{
  "schema_version": "bma.modelSpec.v1",
  "name": "dde_delayed_feedback_expr",
  "title": "delayed negative feedback with tau-parameterised delay",
  "kind": "dde",
  "time": {"unit": "h", "start": 0, "end": 20, "n": 201},
  "variables": [
    {"id": "x", "unit": "1", "initial": {"value": 1}}
  ],
  "delays": [
    {"id": "tau", "expression": "tau", "unit": "h"}
  ],
  "parameters": [
    {"id": "tau", "unit": "h", "value": {"value": 2}},
    {"id": "k", "unit": "1/h", "value": {"value": 0.5}},
    {"id": "d", "unit": "1/h", "value": {"value": 1}}
  ],
  "reactions": [
    {"id": "feedback", "stoichiometry": {"x": 1},
     "rate": {"kind": "expression", "expression": "k*delay(x,tau) - d*x"}}
  ],
  "outputs": [
    {"id": "x", "unit": "1", "expression": "x"}
  ]
}
