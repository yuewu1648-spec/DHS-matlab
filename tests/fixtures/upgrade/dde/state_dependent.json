{
  "schema_version": "bma.modelSpec.v1",
  "name": "dde_state_delay",
  "kind": "dde",
  "dde_mode": "state_dependent",
  "time": {"unit": "h", "start": 0, "end": 20, "n": 201},
  "variables": [{"id": "x", "unit": "1", "initial": {"value": 1}}],
  "delays": [{"id": "tau", "expression": "1 + 0.2*sin(t)", "unit": "h"}],
  "parameters": [{"id": "k", "unit": "1/h", "value": {"value": 1}}],
  "reactions": [{"id": "r", "stoichiometry": {"x": 1}, "rate": {"kind": "expression", "expression": "delay(x,tau)-k*x"}}],
  "outputs": [{"id": "x", "unit": "1", "expression": "x"}]
}
