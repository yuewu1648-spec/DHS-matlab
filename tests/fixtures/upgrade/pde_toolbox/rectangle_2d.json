{
  "schema_version": "bma.modelSpec.v1",
  "name": "pde2d_probe",
  "title": "2D PDE probe",
  "kind": "pde",
  "time": {"unit": "s", "start": 0, "end": 1, "n": 11},
  "variables": [
    {"id": "C", "name": "C", "unit": "1", "initial": {"value": 1}}
  ],
  "pde": {
    "dim": 2,
    "solver": "toolbox",
    "domain": {
      "geometry": "rectangle",
      "size": [1, 1],
      "unit": "um",
      "mesh": {"hmax": 0.2, "hgrad": 1.3},
      "approximation": "2D rectangle"
    },
    "diffusion": [{"species": "C", "coeff": "De"}],
    "bc": [{"edge": "all", "type": "dirichlet", "value": 0}],
    "probes": [{"id": "C_center", "species": "C", "x": 0.5, "y": 0.5}]
  },
  "parameters": [
    {"id": "De", "unit": "um^2/s", "value": {"value": 1}},
    {"id": "k", "unit": "1/s", "value": {"value": 0.5}}
  ],
  "reactions": [
    {"id": "decay", "stoichiometry": {"C": -1},
     "rate": {"kind": "expression", "expression": "k*C"}}
  ],
  "outputs": [{"id": "C_center", "unit": "1", "expression": "C"}]
}
