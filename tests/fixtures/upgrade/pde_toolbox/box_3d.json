{
  "schema_version": "bma.modelSpec.v1",
  "name": "pde3d_probe",
  "title": "3D PDE probe",
  "kind": "pde",
  "time": {"unit": "s", "start": 0, "end": 0.5, "n": 6},
  "variables": [{"id": "C", "unit": "1", "initial": {"value": 1}}],
  "pde": {
    "dim": 3,
    "solver": "toolbox",
    "domain": {"geometry": "box", "size": [1, 1, 1], "mesh": {"hmax": 0.4}},
    "diffusion": [{"species": "C", "coeff": "De"}],
    "bc": [{"face": "all", "type": "dirichlet", "value": 0}],
    "probes": [{"id": "center", "species": "C", "x": 0.5, "y": 0.5, "z": 0.5}]
  },
  "parameters": [{"id": "De", "unit": "um^2/s", "value": {"value": 0.1}},
                 {"id": "k", "unit": "1/s", "value": {"value": 0.5}}],
  "reactions": [{"id": "decay", "stoichiometry": {"C": -1},
                 "rate": {"kind": "expression", "expression": "k*C"}}]
}
