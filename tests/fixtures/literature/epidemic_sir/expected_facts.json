  "datasets": [
    {
      "file": "data/community_cases.csv",
      "role": "fit_target",
      "time_unit": "day",
      "columns": {
        "day": "day",
        "new_cases": "person/day",
        "active_infections": "person",
        "cumulative_infections": "person",
        "cumulative_removed": "person"
      },
      "rows": 121,
      "output_map": {"I_obs": "active_infections", "R_obs": "cumulative_removed"},
      "initial_conditions_hint": {"S": 1188.0, "I": 12.0, "R": 0.0},
      "note": "Cumulative infections equal I + R (total ever infected); fit active_infections and/or cumulative_removed. new_cases is the daily difference of cumulative_infections."
