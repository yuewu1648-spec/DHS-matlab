      "value": 0.16, "tolerance": {"relative": 0.08},
      "expected_in_spec": true, "expected_estimate": true,
      "section_hint": "3.1 Estimated parameters",
      "context_keywords": ["removal rate", "0.16"]
    },
    {
      "id": "R0", "role": "derived", "symbol": "R0",
      "names": ["R0", "R_0", "basic reproduction number", "basic reproduction ratio"],
      "unit": "1", "unit_aliases": ["dimensionless", "1"],
      "value": 2.81, "tolerance": {"relative": 0.1},
