  "assertions": {
    "report_must_contain": ["R0", "beta", "gamma", "assumptions"],
    "report_must_contain_case_insensitive": ["sir", "susceptible"],
    "spec_must_have_assumptions": true,
    "parameter_evidence_required": true,
    "expected_output_ids_any_of": ["I_obs", "R_obs"]
