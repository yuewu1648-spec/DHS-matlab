{
  "schema": "bma.fixture.expectations.v1",
  "fixture_id": "epidemic_sir",
  "title": "Dynamics of a respiratory outbreak in an isolated island community: a susceptible-infectious-removed analysis of 120 days of surveillance data",
  "purpose": "SIR compartmental epidemic: beta/gamma/R0, closed population, cumulative and daily incidence data. Exercises expression-based rate law, conservation law analysis and cumulative-output fitting.",
  "formats": ["md", "txt", "html", "docx", "pdf"],
  "expected_sections": [
    "Abstract", "1. Introduction", "2. Materials and methods", "3. Results",
    "4. Discussion", "5. Data availability", "6. References"
  ],
  "expected_model": {
    "kind": "ode",
    "archetype": "sir_epidemic",
    "archetype_synonyms": ["sir", "epidemic_sir", "compartmental_epidemic", "sir_model"],
    "suggested_name": "epidemic_sir",
    "species": ["S", "I", "R"],
    "time_unit": "day",
    "time_span": [0, 120],
    "mechanism_keywords": ["SIR", "susceptible", "infectious", "removed", "R0", "transmission"],
    "expected_reaction_kinds": ["expression", "mass_action"]
